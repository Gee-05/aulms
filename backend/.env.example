SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Email - leave EMAIL_BACKEND as the console backend for local dev.
# Switch to django.core.mail.backends.smtp.EmailBackend + fill in the
# EMAIL_HOST_* values below to send real email in production.
# NOTE: put real credentials in your local .env (gitignored), never here -
# this file is a template meant to be safe to commit.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=library@example.com

# Library business rules - seed defaults only; an Administrator can change
# these at runtime from the app (Admin > Settings), stored in LibraryPolicy.
LOAN_PERIOD_DAYS=14
FINE_PER_DAY=0.50
MAX_RENEWALS=1
RENEWAL_PERIOD_DAYS=7
DUE_SOON_REMINDER_DAYS=2
